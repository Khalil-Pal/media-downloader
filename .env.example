# Sandy Squirrel example environment values.
# Copy this file to .env locally and replace placeholders outside git.

BOT_TOKEN=123456:example-token
ADMIN_ID=123456789
DATABASE_URL=

# Manual payment details shown for RUB upgrades.
# Keep this to receiving-only information, never private banking credentials.
PAYMENT_INFO_RUB="Holder: Example Name
Bank: Example Bank
Account/Card for receiving payments: XXXX XXXX XXXX XXXX"

# Manual payment details shown for USD upgrades.
# Keep this to receiving-only information, never private banking credentials.
PAYMENT_INFO_USD="Holder: Example USD Recipient
Bank: Example USD Bank
IBAN/Account for receiving USD: XX00USDPLACEHOLDER000000
SWIFT/BIC: USDPLACE"

# Manual payment details shown for ILS upgrades.
# Keep this to receiving-only information, never private banking credentials.
PAYMENT_INFO_ILS="Holder: Example ILS Recipient
Bank: Example ILS Bank
IBAN/Account for receiving ILS: IL00ILSPLACEHOLDER000000
SWIFT/BIC: ILSPLACE"

PAYMENT_REVIEW_ETA="within 24 hours"
